---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const it = messages.itineraries;
---

<section id="itineraries" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{it.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{it.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{it.lead}</p>

    <!-- By traveler type -->
    <h3 class="font-display text-2xl text-gold mt-10 mb-4">{it.byGroup.title}</h3>
    <div class="grid md:grid-cols-3 gap-5">
      {it.byGroup.items.map((g) => (
        <div class="rounded-2xl border border-gold/25 bg-white/60 p-6 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">{g.icon}</span>
            <h4 class="font-display text-lg text-teak font-semibold">{g.title}</h4>
          </div>
          <p class="text-sm text-ink/75 mb-3">{g.desc}</p>
          <ul class="space-y-1 text-sm text-ink/70 list-disc list-inside marker:text-gold">
            {g.stops.map((st) => <li>{st}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <!-- By time available -->
    <h3 class="font-display text-2xl text-gold mt-12 mb-4">{it.byDuration.title}</h3>
    <div class="grid md:grid-cols-2 gap-5">
      <div class="rounded-2xl border border-gold/25 bg-teak/5 p-6">
        <h4 class="font-display text-xl text-teak font-semibold">{it.byDuration.half.title}</h4>
        <ol class="mt-3 space-y-2 text-sm text-ink/75 list-decimal list-inside marker:text-gold">
          {it.byDuration.half.steps.map((s) => <li>{s}</li>)}
        </ol>
      </div>
      <div class="rounded-2xl border border-gold/25 bg-teak/5 p-6">
        <h4 class="font-display text-xl text-teak font-semibold">{it.byDuration.full.title}</h4>
        <ol class="mt-3 space-y-2 text-sm text-ink/75 list-decimal list-inside marker:text-gold">
          {it.byDuration.full.steps.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </div>
  </div>
</section>
