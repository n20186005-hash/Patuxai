---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const s = messages.seasons;
const table = s.table;
const comp = s.composite;
---

<section id="seasons" class="py-20 bg-teak text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-2xl text-ivory/80">{s.lead}</p>

    <!-- Seasonal strategy table -->
    <div class="mt-10 overflow-x-auto rounded-2xl border border-gold/20">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-teakDeep/70 text-goldBright">
            {table.head.map((h) => <th class="text-left font-semibold px-4 py-3 whitespace-nowrap">{h}</th>)}
          </tr>
        </thead>
        <tbody>
          {table.rows.map((r) => (
            <tr class="border-t border-gold/15 align-top">
              <td class="px-4 py-3 font-semibold text-goldBright whitespace-nowrap">{r.season}</td>
              <td class="px-4 py-3 text-ivory/85 whitespace-nowrap">{r.months}</td>
              <td class="px-4 py-3 text-ivory/75">{r.weather}</td>
              <td class="px-4 py-3 text-ivory/75">{r.comfort}</td>
              <td class="px-4 py-3 text-ivory/75">{r.rec}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Composite weather / water / wildlife analysis -->
    <div class="mt-10 grid md:grid-cols-3 gap-6">
      <div class="rounded-2xl bg-teakDeep/60 border border-gold/20 p-6">
        <h3 class="font-display text-xl text-goldBright mb-2">{comp.climateTitle}</h3>
        <p class="text-sm text-ivory/80 leading-relaxed">{comp.text}</p>
      </div>
      <div class="rounded-2xl bg-teakDeep/60 border border-gold/20 p-6">
        <h3 class="font-display text-xl text-goldBright mb-2">{comp.waterTitle}</h3>
        <p class="text-sm text-ivory/80 leading-relaxed">{comp.water}</p>
      </div>
      <div class="rounded-2xl bg-teakDeep/60 border border-gold/20 p-6">
        <h3 class="font-display text-xl text-goldBright mb-2">{comp.wildlifeTitle}</h3>
        <p class="text-sm text-ivory/80 leading-relaxed">{comp.wildlife}</p>
      </div>
    </div>

    <!-- Monthly normals -->
    <h3 class="font-display text-2xl text-goldBright mt-12 mb-4">{s.monthsTitle}</h3>
    <div class="overflow-x-auto rounded-2xl border border-gold/20">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-teakDeep/70 text-goldBright">
            <th class="text-left font-semibold px-3 py-2">{s.monthLabel}</th>
            <th class="text-right font-semibold px-3 py-2">{s.tmaxLabel}</th>
            <th class="text-right font-semibold px-3 py-2">{s.tminLabel}</th>
            <th class="text-right font-semibold px-3 py-2">{s.rainLabel}</th>
          </tr>
        </thead>
        <tbody>
          {s.months.map((m) => (
            <tr class="border-t border-gold/15">
              <td class="px-3 py-2 text-ivory/90">{m.month}</td>
              <td class="px-3 py-2 text-right tabular-nums text-ivory/80">{m.tmax}°C</td>
              <td class="px-3 py-2 text-right tabular-nums text-ivory/80">{m.tmin}°C</td>
              <td class="px-3 py-2 text-right tabular-nums text-ivory/80">{m.rain} mm</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ivory/50">{s.monthsNote}</p>
  </div>
</section>
