---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const t = messages.getting;
---

<section id="getting" class="py-20 bg-teak text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{t.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{t.heading}</h2>
    <p class="mt-4 max-w-2xl text-ivory/80">{t.lead}</p>

    <div class="mt-10 grid md:grid-cols-2 gap-6">
      {t.modes.map((m) => (
        <div class="rounded-2xl bg-teakDeep/60 border border-gold/20 p-6">
          <div class="flex items-start gap-4">
            <span class="text-3xl">{m.icon}</span>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-display text-xl text-goldBright">{m.title}</h3>
                {m.time && <span class="chip text-ivory/90">{t.timeLabel} {m.time}</span>}
                {m.cost && <span class="chip text-ivory/90">{t.costLabel} {m.cost}</span>}
              </div>
              <p class="mt-2 text-sm text-ivory/80">{m.intro}</p>
              {m.steps && (
                <ol class="mt-3 space-y-1.5 text-sm text-ivory/75 list-decimal list-inside marker:text-gold">
                  {m.steps.map((s) => <li>{s}</li>)}
                </ol>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-ivory/60 max-w-3xl">{t.note}</p>
  </div>
</section>
