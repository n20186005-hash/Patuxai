---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const f = messages.facilities;
---

<section id="facilities" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{f.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{f.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{f.lead}</p>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {f.items.map((it) => (
        <div class="rounded-2xl border border-gold/25 bg-white/60 p-5 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">{it.icon}</span>
            <h3 class="font-display text-lg text-teak font-semibold">{it.title}</h3>
          </div>
          <p class="text-sm text-ink/75 leading-relaxed">{it.desc}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-ink/60 max-w-3xl">{f.note}</p>
  </div>
</section>
