---
import { siteConfig } from '../config';

interface Props {
  lang: any;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const footer = messages.footer;
const statement = {
  en: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
  lo: 'ເວັບໄຊນີ້ເປັນໂຄງການຂໍ້ມູນທ່ອງທ່ຽວອິດສະຫຼະ ແລະ ບໍ່ຂຶ້ນກັບອົງການລັດ ຫຼື ອົງການທາງການໃດໆ.',
};
---

<footer class="bg-teakDeep text-ivory py-8">
  <div class="max-w-7xl mx-auto px-5 flex flex-col md:flex-row md:items-end md:justify-between gap-5">
    <div class="text-sm text-ivory/80 leading-relaxed space-y-2">
      <p>© 2026 {siteConfig.name[lang]} · {lang === 'zh' ? '版權所有' : lang === 'lo' ? 'ສະຫງວນລິຂະສິດ' : 'All rights reserved'}</p>
      <p>{statement[lang]}</p>
    </div>
    <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-2 md:justify-end text-sm">
      <a href={`/${lang}/privacy-policy/`} class="text-ivory/80 hover:text-goldBright">{footer.privacy}</a>
      <a href={`/${lang}/terms-of-service/`} class="text-ivory/80 hover:text-goldBright">{footer.terms}</a>
      <a href={`/${lang}/cookie-settings/`} class="text-ivory/80 hover:text-goldBright">{footer.cookies}</a>
    </nav>
  </div>
</footer>
