---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Sources from '../../components/Sources.astro';
import Footer from '../../components/Footer.astro';
import { languagesList, getI18n, type Lang } from '../../i18n/ui';
export function getStaticPaths() { return languagesList.map(lang => ({ params: { lang } })); }
const { lang: rawLang } = Astro.params as { lang: Lang };
const { lang, messages } = await getI18n(rawLang);
---
<BaseLayout lang={lang} title={messages.sources.heading} description={messages.sources.intro} path="sources" messages={messages}>
  <Header lang={lang} messages={messages} />
  <main class="pt-16"><Sources messages={messages} /></main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
