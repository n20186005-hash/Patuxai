---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  messages: Record<string, any>;
}
const { lang, title, description, messages } = Astro.props;
const canonical = `${siteConfig.domain}/${lang}/`;

const faqs = (messages && messages.guide && messages.guide.faqs) ? messages.guide.faqs : [];

// Entity-focused description for structured data (mirrors the SEO template).
const entityDescription: Record<Lang, string> = {
  lo: `ຄູ່ມືຜູ້ຢ້ຽມຢາມແບບເຕັມຂອງ ${siteConfig.name.lo} ໃນ${siteConfig.city.lo}, ${siteConfig.stateProvince.lo}, ${siteConfig.country.lo}.`,
  en: `Comprehensive visitor guide to ${siteConfig.name.en} (Victory Gate) in ${siteConfig.city.en}, ${siteConfig.stateProvince.en}, ${siteConfig.country.en}.`,
  zh: `${siteConfig.name.zh}（${siteConfig.city.zh}）完整游客指南——位于${siteConfig.stateProvince.zh}的${siteConfig.country.zh}。`,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': `${siteConfig.domain}/#attraction`,
    name: siteConfig.name[lang],
    alternateName: [
      siteConfig.nameShort[lang],
      'Patuxai',
      'Patuxay',
      'Patuxai Victory Gate',
      'Patuxai Victory Monument',
      `${siteConfig.city.en} ${siteConfig.name.en}`,
    ],
    description: entityDescription[lang],
    url: canonical,
    image: `${siteConfig.domain}${siteConfig.ogImage}`,
    isAccessibleForFree: siteConfig.isAccessibleForFree,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.streetAddress,
      addressLocality: siteConfig.city[lang],
      addressRegion: siteConfig.stateProvince[lang],
      postalCode: siteConfig.postalCode,
      addressCountry: 'LA',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: siteConfig.coords.lat,
      longitude: siteConfig.coords.lng,
    },
    hasMap: siteConfig.mapsUrl,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: siteConfig.rating,
      reviewCount: siteConfig.reviewCount.replace(/,/g, ''),
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: siteConfig.openingHours.opens,
        closes: siteConfig.openingHours.closes,
      },
    ],
    sameAs: siteConfig.sameAs,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={siteConfig.ogImage} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteConfig.domain}${siteConfig.ogImage}`} />
    <meta property="og:image:alt" content={`${siteConfig.name[lang]} — ${siteConfig.city[lang]}, ${siteConfig.country[lang]}`} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#7a5c2e" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.nameShort[lang]} />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    {languagesList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={`${siteConfig.domain}/${l}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.domain}/en/`} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HXM22WWPKP');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&family=Noto+Sans+Lao:wght@300;400;500;700&family=Noto+Serif+Lao:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- PWA service worker registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class="grain">
    <slot />
  </body>
</html>
